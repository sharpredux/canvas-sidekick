{
  "name": "canvas-sidekick",
  "private": true,
  "version": "0.1.4",
  "description": "A desktop Canvas LMS agenda and local AI study assistant.",
  "author": {
    "name": "sharpredux",
    "email": "136175540+sharpredux@users.noreply.github.com"
  },
  "homepage": "https://github.com/sharpredux/canvas-sidekick",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:widget-ui": "npm run build && node tests/verify-widget-ui.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "dev:app": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage rpm",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "io.github.sharpredux.canvassidekick",
    "productName": "Canvas Sidekick",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Education",
      "synopsis": "Canvas LMS agenda and local AI study assistant",
      "description": "A compact desktop widget for Canvas assignments, announcements, schedules, and local Ollama assistance.",
      "executableName": "canvas-sidekick",
      "icon": "build/icons"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "koffi": "*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
